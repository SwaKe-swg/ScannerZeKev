# Zephyr Sniper Bot 2.3 — PAPER defaults. Never commit real .env.
BOT_VERSION=2.3
# REAL_TRADING is hardcoded False in config.py — do not enable live trading here.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HELIUS_API_KEY=
HELIUS_RPC_URL=
DEXSCREENER_WS_URL=wss://io.dexscreener.com/ws/solana/pairs
JUPITER_PRICE_API=https://api.jup.ag/price/v2

# Paper budget ~100 EUR @ SOL/EUR ≈ 102.16 → ~0.98 SOL
VIRTUAL_SOL_BALANCE=0.98
TRADE_AMOUNT_SOL=0.02
# TRADE_SIZE_SOL=0.02

SLIPPAGE_BPS=150
ESTIMATED_FEE_SOL=0.0015
TAKE_PROFIT_PCT=35.0
STOP_LOSS_PCT=-15.0
MAX_OPEN_POSITIONS=2
COOLDOWN_SECONDS=90

MIN_LIQUIDITY=12000
MIN_MARKET_CAP=20000
MAX_MARKET_CAP=250000
MAX_AGE_MINUTES=180
MIN_HOLDERS=10
MIN_BUYS_M5=8
MIN_BUY_SELL_RATIO=1.2
MIN_VOLUME_M5=2000
MIN_ENTRY_SCORE=70
MIN_PRICE_CHANGE_M5=3.0
MAX_PRICE_CHANGE_M5=80.0
BLACKLIST_HOURS=6.0
REQUIRE_SOCIALS=0

# Anti-scam / on-chain
CHECK_MINT_AUTHORITY=1
CHECK_FREEZE_AUTHORITY=1
CHECK_TRANSFER_FEE=1
MAX_TRANSFER_FEE_PCT=5.0
CHECK_TOP_HOLDER=1
MAX_TOP_HOLDER_PCT=20.0
USE_ANTI_SCAM_ENGINE=1
USE_RUGCHECK=1
USE_ONCHAIN_CHECKS=1
FAIL_CLOSED_ONCHAIN=1
FAIL_CLOSED_RUGCHECK=0
MAX_RUGCHECK_RAW_SCORE=1500

# Never-green confirm (NP lesson)
CONFIRM_ENTRY=1
CONFIRM_ENTRY_SECONDS=20
CONFIRM_MAX_DRAWDOWN_PCT=5.0
FAIL_CLOSED_CONFIRM=1
